# =============================================================
#  InvenLeo — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit your actual .env file to version control.
# =============================================================


# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express server will listen on
PORT=5000

# Set to "production" when deploying
NODE_ENV=development


# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
# Atlas format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local format: mongodb://localhost:27017/<dbname>
MONGO_URI=


# ─── JSON Web Token ───────────────────────────────────────────────────────────
# Long random secret used to sign access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# How long an access token stays valid  (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d


# ─── CORS / Frontend ──────────────────────────────────────────────────────────
# The exact origin of your frontend app (no trailing slash)
# Development default: http://localhost:5173
# Production example:  https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173


# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Any SMTP-compatible provider works (Gmail, SendGrid, Mailgun, etc.)
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password and paste it as SMTP_PASS below
#
# SendGrid setup:
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<api_key>

SMTP_HOST=
SMTP_PORT=587
# Set to "true" only when using port 465 (SSL), keep "false" for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# "From" address shown to email recipients  (e.g.  InvenLeo <no-reply@yourdomain.com>)
EMAIL_FROM=


# ─── Password Reset ───────────────────────────────────────────────────────────
# How many minutes a password-reset link remains valid
RESET_TOKEN_EXPIRES_MINUTES=15